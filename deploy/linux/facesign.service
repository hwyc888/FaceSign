[Unit]
Description=FaceSign Student Attendance Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=facesign
Group=facesign
WorkingDirectory=/var/lib/facesign
Environment=FACESIGN_ENV_FILE=/etc/facesign/facesign.env
ExecStart=/opt/facesign/facesign
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/facesign

[Install]
WantedBy=multi-user.target
